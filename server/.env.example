# General
SECRET_KEY='<secret-key>'
# True for local dev, False for prod
DEBUG=True
# comma-separated hosts/domains allowed to serve the app
DJANGO_ALLOWED_HOSTS='localhost, 127.0.0.1'

# Database (MySQL)
DB_NAME=comments
DB_USER=comments
DB_PASSWORD='<db-password>'
# 127.0.0.1 locally; "db" (compose service name) inside Docker
DB_HOST=127.0.0.1
DB_PORT=3306
