# General
SECRET_KEY='<secret-key>'
# True for local dev, False for prod
DEBUG=True
# comma-separated hosts/domains allowed to serve the app
DJANGO_ALLOWED_HOSTS='localhost, 127.0.0.1'

# Database (MySQL)
DB_NAME=comments
DB_USER=comments
DB_PASSWORD='<db-password>'
DB_ROOT_PASSWORD='<db-root-password>'
# 127.0.0.1 locally; compose overrides web to "db" service name
DB_HOST=127.0.0.1
DB_PORT=3306

# Cache (Redis)
# 127.0.0.1 locally; compose overrides web to "redis" service name
REDIS_URL=redis://127.0.0.1:6379/0

# Celery (Redis broker, separate DB from cache)
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Channels (Redis layer, separate DB)
CHANNELS_REDIS_URL=redis://127.0.0.1:6379/2

# Production (compose.prod sets config.settings.prod; add your server host to DJANGO_ALLOWED_HOSTS)
CSRF_TRUSTED_ORIGINS='http://localhost'
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
